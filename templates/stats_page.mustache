{{!
    AI 编程助手 - 全局统计页面模板

    展示 AI 助手的全局使用统计数据，包括概览、热门试题和学生使用排行。

    @template local_ai_programming_assistant/stats_page
    @author zfl
}}
<div class="ai-programming-assistant-stats-page">

    {{> local_ai_programming_assistant/nav_tabs}}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>

            <span class="text-muted small fw-bold">
                {{#str}}stats_page_title, local_ai_programming_assistant{{/str}}
            </span>
            <span class="mx-2 text-muted small">&gt;</span>
            <a href="{{{recentquizchatsurl}}}" class="btn btn-outline-info btn-sm ms-2">
                {{#str}}recent_quiz_chats_page_title, local_ai_programming_assistant{{/str}}
            </a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" action="" class="d-flex justify-content-between align-items-start gap-3">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-end gap-2">
                        {{#has_courses}}
                        <div>
                            <label for="courseid" class="form-label small mb-0">{{#str}}course, core{{/str}}</label>
                            <select id="courseid" name="courseid" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="0">{{#str}}all, core{{/str}}</option>
                                {{#courses}}
                                <option value="{{id}}" {{#isselected}}selected{{/isselected}}>{{fullname}}</option>
                                {{/courses}}
                            </select>
                        </div>
                        {{/has_courses}}
                        {{#has_quizzes}}
                        <div>
                            <label for="quizid" class="form-label small mb-0">{{#str}}stats_quiz, local_ai_programming_assistant{{/str}}</label>
                            <select id="quizid" name="quizid" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="0" {{^quizid}}selected{{/quizid}}>
                                    {{#str}}stats_all_quizzes, local_ai_programming_assistant{{/str}}
                                </option>
                                {{#quizzes}}
                                <option value="{{quizid}}" {{#isselected}}selected{{/isselected}}>{{quiz_name}}</option>
                                {{/quizzes}}
                            </select>
                        </div>
                        {{/has_quizzes}}
                    </div>
                    <div>
                        <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}stats_date_presets, local_ai_programming_assistant{{/str}}">
                            {{#presets}}
                            <a href="?starttime={{starttime_display}}&amp;endtime={{endtime_display}}&amp;quizid={{quizid}}&amp;courseid={{courseid}}"
                               class="btn btn-outline-primary {{#isactive}}active{{/isactive}}">
                                {{label}}
                            </a>
                            {{/presets}}
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-end gap-2 flex-wrap">
                    <div>
                        <label for="starttime" class="form-label small mb-0">{{#str}}stats_time_from, local_ai_programming_assistant{{/str}}</label>
                        <input type="date" id="starttime" name="starttime" class="form-control form-control-sm"
                               value="{{starttime_display}}" style="width:140px">
                    </div>
                    <div>
                        <label for="endtime" class="form-label small mb-0">{{#str}}stats_time_to, local_ai_programming_assistant{{/str}}</label>
                        <input type="date" id="endtime" name="endtime" class="form-control form-control-sm"
                               value="{{endtime_display}}" style="width:140px">
                    </div>
                    <div class="d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm">{{#str}}stats_search_btn, local_ai_programming_assistant{{/str}}</button>
                        {{#has_export}}
                        <a href="?export=csv&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}&amp;quizid={{quizid}}&amp;courseid={{courseid}}&amp;studentsearch={{studentsearch}}"
                           class="btn btn-outline-success btn-sm">
                            {{#str}}export_csv, local_ai_programming_assistant{{/str}}
                        </a>
                        {{/has_export}}
                    </div>
                </div>
            </form>
        </div>
    </div>

    {{#quizid}}
    <div class="alert alert-info mb-3">
        {{#str}}stats_quiz, local_ai_programming_assistant{{/str}}: {{currentquizname}}
        <a href="?starttime={{starttime_display}}&amp;endtime={{endtime_display}}{{#courseid}}&amp;courseid={{courseid}}{{/courseid}}" class="ms-2">{{#str}}stats_all_quizzes, local_ai_programming_assistant{{/str}}</a>
    </div>
    {{/quizid}}

    {{^has_export}}
    <div class="alert alert-info mb-3" role="alert">
        {{#str}}stats_no_data, local_ai_programming_assistant{{/str}}
    </div>
    {{/has_export}}

    {{#has_export}}
    <div class="ai-programming-assistant-stats-questions mt-4">
