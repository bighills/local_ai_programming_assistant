                            <td colspan="5" class="text-center">{{#str}}stats_no_data, local_ai_programming_assistant{{/str}}</td>
                        </tr>
                        {{/topquestions}}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">
                        {{#qhas_pagination}}{{qpagestartitem}} - {{qpageenditem}} / {{/qhas_pagination}}{{qtotalcount}}
                    </small>
                    <select class="form-select form-select-sm" style="width:auto" onchange="if(this.value)window.location.href=this.value">
                        {{#qperpageoptions}}
                        <option value="{{{url}}}" {{#selected}}selected{{/selected}}>{{value}}</option>
                        {{/qperpageoptions}}
                    </select>
                    <button type="button" id="qdeletebtn" class="btn btn-danger btn-sm" disabled>
                        {{#str}}stats_question_delete_btn, local_ai_programming_assistant{{/str}}
                    </button>
                </div>
                {{#qhas_pagination}}
                <nav aria-label="{{#str}}stats_questions_pagination, local_ai_programming_assistant{{/str}}">
                    <ul class="pagination pagination-sm mb-0">
                        {{#qhas_previous}}
                        <li class="page-item"><a class="page-link" href="{{{qprevurl}}}">&laquo;</a></li>
                        {{/qhas_previous}}
                        {{^qhas_previous}}
                        <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                        {{/qhas_previous}}
                        {{#qpagination}}
                        <li class="page-item {{#is_active}}active{{/is_active}}">
                            <a class="page-link" href="{{{url}}}">{{page}}</a>
                        </li>
                        {{/qpagination}}
                        {{#qhas_next}}
                        <li class="page-item"><a class="page-link" href="{{{qnexturl}}}">&raquo;</a></li>
                        {{/qhas_next}}
                        {{^qhas_next}}
                        <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                        {{/qhas_next}}
                    </ul>
                </nav>
                {{/qhas_pagination}}
            </div>
            </form>
        </div>
    </div>

