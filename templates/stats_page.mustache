                <span>{{#str}}stats_top_questions, local_ai_programming_assistant{{/str}}</span>
                <small class="text-muted">{{qtotalcount}} {{#str}}stats_question, local_ai_programming_assistant{{/str}}</small>
            </div>
            <form id="qdeleteform" method="post" action="{{{q_delete_action_url}}}">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="width:30px"><input type="checkbox" id="qselectall" title="{{#str}}conversation_delete_select_all, local_ai_programming_assistant{{/str}}"></th>
                            <th>
                                {{#str}}stats_question, local_ai_programming_assistant{{/str}}
                            </th>
                            <th>
                                {{#str}}stats_question_name, local_ai_programming_assistant{{/str}}
                            </th>
                            <th>
                                <a href="{{{qsorturls.total_requests}}}" class="text-decoration-none text-reset">
                                    {{#str}}stats_conversation_count, local_ai_programming_assistant{{/str}}
                                    {{#q_total_requests_asc}} ▲{{/q_total_requests_asc}}
                                    {{#q_total_requests_desc}} ▼{{/q_total_requests_desc}}
                                </a>
                            </th>
                            <th>
                                <a href="{{{qsorturls.last_timecreated}}}" class="text-decoration-none text-reset">
                                    {{#str}}stats_last_interaction, local_ai_programming_assistant{{/str}}
                                    {{#q_last_timecreated_asc}} ▲{{/q_last_timecreated_asc}}
                                    {{#q_last_timecreated_desc}} ▼{{/q_last_timecreated_desc}}
                                </a>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#topquestions}}
                        <tr>
                            <td><input type="checkbox" value="{{questionid}}" class="q-select"></td>
                            <td><span class="fw-bold">{{questionid}}</span></td>
                            <td>{{questionname}}</td>
                            <td>
                                <a href="{{wwwroot}}/local/ai_programming_assistant/conversation_list.php?questionid={{questionid}}{{#quizid}}&amp;quizid={{quizid}}{{/quizid}}&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}"
                                   class="text-decoration-none" title="{{#str}}stats_view_question_conversations, local_ai_programming_assistant{{/str}}">
                                    {{total_requests}}
                                </a>
                                <a href="{{wwwroot}}/local/ai_programming_assistant/asked_questions.php?questionid={{questionid}}{{#quizid}}&amp;quizid={{quizid}}{{/quizid}}&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}"
                                   class="badge bg-info text-white ms-1 align-middle" title="{{#str}}asked_questions_view_question, local_ai_programming_assistant{{/str}}">
                                    {{#str}}asked_questions_short, local_ai_programming_assistant{{/str}}
                                </a>
                            </td>
                            <td>{{last_timecreated_str}}</td>
                        </tr>
                        {{/topquestions}}
                        {{#has_questiontotals}}
                        <tr class="table-secondary fw-bold">
                            <td></td>
                            <td colspan="2">{{#str}}stats_total, local_ai_programming_assistant{{/str}}</td>
                            <td>{{questiontotals.total_requests}}</td>
                            <td>-</td>
                        </tr>
                        {{/has_questiontotals}}
                        {{^topquestions}}
