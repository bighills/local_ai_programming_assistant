    {{/has_export}}

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        function setupDeleteForm(formId, selectAllId, deleteBtnId, checkboxClass, recordidsName) {
            var form = document.getElementById(formId);
            if (!form) return;
            var selectAll = document.getElementById(selectAllId);
            var deleteBtn = document.getElementById(deleteBtnId);

            function getCheckboxes() {
                return form.querySelectorAll('.' + checkboxClass);
            }
            function getCheckedCount() {
                return form.querySelectorAll('.' + checkboxClass + ':checked').length;
            }
            function updateBtn() {
                if (deleteBtn) deleteBtn.disabled = getCheckedCount() === 0;
            }

            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    getCheckboxes().forEach(function(cb) { cb.checked = selectAll.checked; });
                    updateBtn();
                });
            }
            form.addEventListener('change', function(e) {
                if (e.target && e.target.classList.contains(checkboxClass)) {
                    var total = getCheckboxes().length;
                    var checked = getCheckedCount();
                    if (selectAll) selectAll.checked = total === checked && total > 0;
                    updateBtn();
                }
            });
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function() {
                    var count = getCheckedCount();
                    if (count === 0) return;
                    var confirmMsg = {{{confirm_delete_msg_json}}};
                    confirmMsg = confirmMsg.replace('__COUNT__', count);
                    if (!confirm(confirmMsg)) return;
                    var ids = [];
                    getCheckboxes().forEach(function(cb) {
                        if (cb.checked) ids.push(cb.value);
                    });
                    var actionInput = document.createElement('input');
                    actionInput.type = 'hidden';
                    actionInput.name = 'action';
                    actionInput.value = 'delete';
                    form.appendChild(actionInput);
                    var idsInput = document.createElement('input');
                    idsInput.type = 'hidden';
                    idsInput.name = 'recordids';
                    idsInput.value = ids.join(',');
                    form.appendChild(idsInput);
                    var sesskeyInput = document.createElement('input');
                    sesskeyInput.type = 'hidden';
                    sesskeyInput.name = 'sesskey';
                    sesskeyInput.value = M.cfg.sesskey;
                    form.appendChild(sesskeyInput);
                    form.submit();
                });
            }
        }
        setupDeleteForm('qdeleteform', 'qselectall', 'qdeletebtn', 'q-select', 'recordids');
        setupDeleteForm('sdeleteform', 'sselectall', 'sdeletebtn', 's-select', 'recordids');
    });
    </script>
</div>