{{!
    AI 编程助手 - 使用总揽页面模板

    合并展示试题模式 + 自由模式的整体使用情况：KPI 卡片、每日趋势柱状图、
    模式/模型分布、试题模式 vs 自由模式对比、Top 榜单快捷入口。

    @template local_ai_programming_assistant/overview_page
    @author zfl
}}
<div class="ai-programming-assistant-overview-page">

    {{> local_ai_programming_assistant/nav_tabs}}

    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" action="" class="d-flex justify-content-between align-items-start gap-3">
                <div class="d-flex flex-column gap-2">
                    {{#has_courses}}
                    <div class="d-flex align-items-end gap-2">
                        <div>
                            <label for="courseid" class="form-label small mb-0">{{#str}}course, core{{/str}}</label>
                            <select id="courseid" name="courseid" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="0">{{#str}}all, core{{/str}}</option>
                                {{#courses}}
                                <option value="{{id}}" {{#isselected}}selected{{/isselected}}>{{fullname}}</option>
                                {{/courses}}
                            </select>
                        </div>
                    </div>
                    {{/has_courses}}
                    <div>
                        <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}stats_date_presets, local_ai_programming_assistant{{/str}}">
                            {{#presets}}
                            <a href="?starttime={{starttime_display}}&amp;endtime={{endtime_display}}&amp;courseid={{courseid}}"
                               class="btn btn-outline-primary {{#isactive}}active{{/isactive}}">
                                {{label}}
                            </a>
                            {{/presets}}
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-end gap-2 flex-wrap">
                    <div>
                        <label for="starttime" class="form-label small mb-0">{{#str}}stats_time_from, local_ai_programming_assistant{{/str}}</label>
                        <input type="date" id="starttime" name="starttime" class="form-control form-control-sm"
                               value="{{starttime_display}}" style="width:140px">
                    </div>
                    <div>
                        <label for="endtime" class="form-label small mb-0">{{#str}}stats_time_to, local_ai_programming_assistant{{/str}}</label>
                        <input type="date" id="endtime" name="endtime" class="form-control form-control-sm"
                               value="{{endtime_display}}" style="width:140px">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">{{#str}}stats_search_btn, local_ai_programming_assistant{{/str}}</button>
                </div>
            </form>
        </div>
    </div>

    {{^hasdata}}
    <div class="alert alert-info mb-3" role="alert">
        {{#str}}overview_no_data, local_ai_programming_assistant{{/str}}
    </div>
    {{/hasdata}}

    {{#hasdata}}
    {{! ===== KPI 卡片行 ===== }}
    <div class="row row-cols-2 row-cols-md-4 g-2 mb-3 ai-overview-kpi">
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body px-2 py-3">
                    <div class="ai-overview-kpi-value">{{stats.total_conversations}}</div>
                    <div class="ai-overview-kpi-label">{{#str}}overview_kpi_total_conversations, local_ai_programming_assistant{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body px-2 py-3">
                    <div class="ai-overview-kpi-value">{{stats.unique_users}}</div>
                    <div class="ai-overview-kpi-label">{{#str}}overview_kpi_unique_users, local_ai_programming_assistant{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body px-2 py-3">
                    <div class="ai-overview-kpi-value">{{stats.unique_questions}}</div>
                    <div class="ai-overview-kpi-label">{{#str}}overview_kpi_unique_questions, local_ai_programming_assistant{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body px-2 py-3">
                    <div class="ai-overview-kpi-value">{{stats.unique_pages}}</div>
                    <div class="ai-overview-kpi-label">{{#str}}overview_kpi_unique_pages, local_ai_programming_assistant{{/str}}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-3">
        {{! ===== 试题模式 vs 自由模式对比 ===== }}
        {{#has_mode_split}}
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_quiz_vs_free, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body">
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>{{#str}}overview_quiz_mode, local_ai_programming_assistant{{/str}}</span>
                            <span class="text-muted">{{quiz_mode_count}} ({{quiz_mode_percent}}%)</span>
                        </div>
                        <div class="ai-overview-distribution-bar">
                            <div class="ai-overview-distribution-fill bg-primary" style="width: {{quiz_mode_percent}}%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>{{#str}}overview_free_mode, local_ai_programming_assistant{{/str}}</span>
                            <span class="text-muted">{{free_mode_count}} ({{free_mode_percent}}%)</span>
                        </div>
                        <div class="ai-overview-distribution-bar">
                            <div class="ai-overview-distribution-fill bg-info" style="width: {{free_mode_percent}}%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/has_mode_split}}

        {{! ===== 模型分布 ===== }}
        {{#has_modelusage}}
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_model_distribution, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body">
                    {{#stats.model_usage}}
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>{{key}}</span>
                            <span class="text-muted">{{value}} ({{percent}}%)</span>
                        </div>
                        <div class="ai-overview-distribution-bar">
                            <div class="ai-overview-distribution-fill bg-success" style="width: {{percent}}%"></div>
                        </div>
                    </div>
                    {{/stats.model_usage}}
                </div>
            </div>
        </div>
        {{/has_modelusage}}
    </div>

    {{! ===== 模式分布（独立一行，纯数据展示） ===== }}
    {{#has_modeusage}}
    <div class="row g-2 mb-3">
        <div class="col-12">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_mode_distribution, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body">
                    <div class="row row-cols-2 row-cols-md-4 g-2">
                        {{#stats.mode_usage}}
                        <div class="col">
                            <div class="card text-center h-100">
                                <div class="card-body px-2 py-3">
                                    <div class="ai-overview-kpi-value">{{value}}</div>
                                    <div class="ai-overview-kpi-label">{{modelabel}}</div>
                                </div>
                            </div>
                        </div>
                        {{/stats.mode_usage}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/has_modeusage}}

    {{! ===== Top 5 榜单三列 ===== }}
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_top_questions, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#topquestions}}
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <a href="{{{wwwroot}}}/local/ai_programming_assistant/conversation_list.php?questionid={{questionid}}&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}{{#courseid}}&amp;courseid={{courseid}}{{/courseid}}"
                               class="text-decoration-none text-truncate" title="{{questionname}}">
                                {{questionname}}
                            </a>
                            <span class="badge bg-primary rounded-pill">{{total_requests}}</span>
                        </li>
                        {{/topquestions}}
                        {{^has_topquestions}}
                        <li class="list-group-item text-center text-muted">{{#str}}stats_no_data, local_ai_programming_assistant{{/str}}</li>
                        {{/has_topquestions}}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_top_students, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#topstudents}}
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <a href="{{{wwwroot}}}/local/ai_programming_assistant/conversation_list.php?userid={{userid}}&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}{{#courseid}}&amp;courseid={{courseid}}{{/courseid}}"
                               class="text-decoration-none text-truncate" title="{{fullname}}">
                                {{fullname}}
                            </a>
                            <span class="badge bg-primary rounded-pill">{{total_requests}}</span>
                        </li>
                        {{/topstudents}}
                        {{^has_topstudents}}
                        <li class="list-group-item text-center text-muted">{{#str}}stats_no_data, local_ai_programming_assistant{{/str}}</li>
                        {{/has_topstudents}}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-header">{{#str}}overview_top_free_pages, local_ai_programming_assistant{{/str}}</div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#topfreepages}}
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <a href="{{{wwwroot}}}/local/ai_programming_assistant/free_chat_detail.php?userid={{userid}}&amp;contextid={{contextid}}&amp;starttime={{starttime_display}}&amp;endtime={{endtime_display}}"
                               class="text-decoration-none text-truncate" title="{{coursename}}{{#modname}} / {{modname}}{{/modname}}">
                                {{coursename}}{{#modname}} <small class="text-muted">/ {{modname}}</small>{{/modname}}
                            </a>
                            <span class="badge bg-info rounded-pill">{{interaction_count}}</span>
                        </li>
                        {{/topfreepages}}
                        {{^has_topfreepages}}
                        <li class="list-group-item text-center text-muted">{{#str}}stats_no_data, local_ai_programming_assistant{{/str}}</li>
                        {{/has_topfreepages}}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {{! ===== 快捷入口 ===== }}
    <div class="card">
        <div class="card-header">{{#str}}overview_quick_links, local_ai_programming_assistant{{/str}}</div>
        <div class="card-body d-flex flex-wrap gap-2">
            <a href="{{{statsurl}}}" class="btn btn-outline-primary btn-sm">{{#str}}stats_page_title, local_ai_programming_assistant{{/str}}</a>
            <a href="{{{freestatsurl}}}" class="btn btn-outline-primary btn-sm">{{#str}}free_stats_page_title, local_ai_programming_assistant{{/str}}</a>
            <a href="{{{recentquizchatsurl}}}" class="btn btn-outline-info btn-sm">{{#str}}recent_quiz_chats_page_title, local_ai_programming_assistant{{/str}}</a>
            <a href="{{{recentfreechatsurl}}}" class="btn btn-outline-info btn-sm">{{#str}}recent_free_chats_page_title, local_ai_programming_assistant{{/str}}</a>
            <a href="{{{conversationlisturl}}}" class="btn btn-outline-info btn-sm">{{#str}}conversation_list_page_title, local_ai_programming_assistant{{/str}}</a>
        </div>
    </div>
    {{/hasdata}}

</div>
